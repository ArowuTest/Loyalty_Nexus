<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Must match NexusColors.background (0xFF0F1123) in lib/src/core/theme/nexus_theme.dart.
         The native window is painted with this before Flutter's first frame; any
         mismatch shows as a flash at launch. -->
    <color name="nexus_background">#FF0F1123</color>
	<color name="ic_launcher_background">#0F1123</color>
    <!-- Tint applied to the notification silhouette. Matches the web manifest
         theme_color and NexusColors.primary. -->
    <color name="nexus_notification_accent">#FF5F72F9</color>
</resources>